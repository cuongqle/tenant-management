# Local only. Copy to .env and fill in values.
# Do not commit .env. Production (Render) sets the same keys in the dashboard.

# Local Docker Postgres:
DATABASE_URL=postgresql+psycopg://tenantmng:tenantmng_dev@localhost:5432/tenantmng

# Neon / production — Render env var. postgresql:// is rewritten to +psycopg.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/tenantmng?sslmode=require

JWT_SECRET_KEY=dev-secret-change-me-to-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
